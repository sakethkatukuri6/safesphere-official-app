<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F18"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="30dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️"
                android:textSize="36sp"
                android:layout_marginEnd="10dp"/>
            
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SAFESPHERE"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFFICIAL APP"
                    android:textColor="#7A879E"
                    android:textSize="12sp"
                    android:letterSpacing="0.1" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvModeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟢 FIELD MODE - ACTIVE"
            android:textColor="#4CAF50"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_pill_green"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"/>

        <!-- INCIDENT CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIncident"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#131A26"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:strokeColor="#253145"
            app:strokeWidth="1dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvIncidentId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_incident_header"
                    android:padding="12dp"
                    android:text="INCIDENT: CR-301               ⚠️"
                    android:textColor="#F3A754"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVictimName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="👤 Victim: Jane Doe"
                    android:textColor="#D3D9E4"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🩸 Blood Type: "
                        android:textColor="#D3D9E4"
                        android:textSize="15sp" />
                        
                    <TextView
                        android:id="@+id/tvBloodType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" O+ "
                        android:textColor="#FF4C4C"
                        android:background="@drawable/bg_blood_badge"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#253145"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENTER OTP (FIELD MODE)"
                    android:textColor="#7A879E"
                    android:textSize="11sp"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etOtp"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_otp_input"
                        android:hint="1 2 3 4 5 6"
                        android:textColorHint="#45536B"
                        android:textColor="#FFFFFF"
                        android:inputType="number"
                        android:maxLength="6"
                        android:paddingHorizontal="16dp"
                        android:letterSpacing="0.3"
                        android:layout_marginEnd="12dp"
                        android:textSize="18sp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubmitOtp"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="🔕 SILENCE\nALERT"
                        android:textColor="#FF5C5C"
                        android:textSize="12sp"
                        app:strokeColor="#80FF5C5C"
                        app:strokeWidth="1dp"
                        app:backgroundTint="#131A26"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- DEBUG CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#0D131C"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#253145"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SIMULATION &amp; DEBUG CONTROLS"
                    android:textColor="#7A879E"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="16dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSimulateCommand"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="🔄   SIMULATE COMMAND DESK UPDATE"
                    android:textColor="#D3D9E4"
                    android:textAlignment="viewStart"
                    android:paddingStart="20dp"
                    app:backgroundTint="#131A26"
                    app:strokeColor="#2C3A53"
                    app:strokeWidth="1dp"
                    app:cornerRadius="8dp"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSimulateField"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="📍   SIMULATE FIELD MODE ASSIGNMENT"
                    android:textColor="#D3D9E4"
                    android:textAlignment="viewStart"
                    android:paddingStart="20dp"
                    app:backgroundTint="#131A26"
                    app:strokeColor="#2C3A53"
                    app:strokeWidth="1dp"
                    app:cornerRadius="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
